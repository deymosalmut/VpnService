# ============================================
# VPN Service — Dev Environment
# Copy to .env and adjust as needed
# ============================================

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=vpn
POSTGRES_PASSWORD=vpn_dev_password
POSTGRES_DB=vpn_users
DATABASE_URL=postgres://vpn:vpn_dev_password@localhost:5432/vpn_users?sslmode=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=vpn
RABBITMQ_PASSWORD=vpn_dev_password
RABBITMQ_VHOST=vpn
RABBITMQ_URL=amqp://vpn:vpn_dev_password@localhost:5672/vpn

# Marzban
MARZBAN_BASE_URL=http://localhost:8000
MARZBAN_ADMIN_USER=admin
MARZBAN_ADMIN_PASSWORD=marzban_dev_password

# Auth Service
AUTH_JWT_SECRET=dev-jwt-secret-change-in-production
AUTH_LINK_TTL=300
AUTH_PORT=3001

# Billing Service
BILLING_PORT=3002
# SBP webhook secret (заглушка для dev)
SBP_WEBHOOK_SECRET=dev-sbp-secret
# Cryptomus (заглушка для dev)
CRYPTOMUS_API_KEY=dev-cryptomus-key
CRYPTOMUS_MERCHANT_ID=dev-merchant-id

# Notification
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_ADMIN_CHAT_ID=your-chat-id-here
