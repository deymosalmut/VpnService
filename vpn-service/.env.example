# Database Configuration
DATABASE_URL=postgres://vpn:vpn_dev_password@localhost:5432/vpn_users?sslmode=disable
POSTGRES_USER=vpn
POSTGRES_PASSWORD=vpn_dev_password
POSTGRES_DB=vpn_users

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# RabbitMQ Configuration
RABBITMQ_URL=amqp://vpn:vpn_dev_password@localhost:5672/vpn
RABBITMQ_PASSWORD=vpn_dev_password
RABBITMQ_DEFAULT_USER=vpn

# Auth Service Configuration
AUTH_JWT_SECRET=dev-jwt-secret-change-in-production
AUTH_PORT=3000
AUTH_TOKEN_EXPIRY=86400  # 24 hours in seconds

# Billing Service Configuration
BILLING_PORT=3000
CRYPTOMUS_API_KEY=dev-cryptomus-key-change-in-production
CRYPTOMUS_MERCHANT_ID=dev-merchant-id-change-in-production
SBP_WEBHOOK_SECRET=dev-sbp-secret-change-in-production

# Proxy Control Configuration
PROXY_CTRL_PORT=3000
MARZBAN_BASE_URL=http://marzban:8000
MARZBAN_ADMIN_USER=admin
MARZBAN_ADMIN_PASSWORD=marzban_dev_password
XRAY_INBOUND_TAG=VLESS_REALITY
PROXY_CONFIG_TTL=86400  # 24 hours

# User Management Configuration
USER_MGMT_PORT=3000

# Notification Service Configuration
NOTIFICATION_PORT=3000
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Logging
LOG_LEVEL=info
LOG_FORMAT=json  # json or text

# Environment
ENVIRONMENT=development  # development, staging, production

# Marzban WebUI
MARZBAN_SUB_PREFIX=http://localhost:8000
MARZBAN_DOCS=true
